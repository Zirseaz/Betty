# ──────────────────────────────────────────────
# PolyAgent – Environment Configuration
# Copy to .env and fill in your secrets.
# ──────────────────────────────────────────────

# ── Polymarket CLOB credentials ──────────────
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ── Trading mode ─────────────────────────────
# "paper" = simulated orders (default), "live" = real orders on Polymarket
MODE=paper

# ── Risk management ──────────────────────────
MAX_POSITION_SIZE_USD=50
MAX_TOTAL_EXPOSURE_USD=500
MAX_DRAWDOWN_PCT=15
MIN_EDGE_PCT=2

# ── LLM provider ─────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=

# ── Telegram notifications ───────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Scanner / scheduler ─────────────────────
SCAN_INTERVAL_SECONDS=30
TARGET_CATEGORIES=all

# ── Database ─────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/polyagent.db
